# ── CS 셀프가이드 · 실시간 상담 환경변수 ─────────────────────────────────────
# 새 서버를 세팅할 때 이 목록을 기준으로 채운다. 이 파일은 저장소에 올라가므로 실제 값은 넣지 않는다.
# 실제 값은 로컬 .env.local / 서버(Vercel 등) 환경변수에 넣는다.

# [필수] 데이터베이스 — FAQ·상담·통계·연차·녹취 분석 등 모든 데이터
MONGODB_URI=

# [필수] Claude
#  - 고객 'AI에게 바로 질문하기': ANTHROPIC_ANSWER_MODEL (비우면 기본값 claude-haiku-5-5)
#  - 상담 도우미·녹취 분석·응대 자산 정리: ANTHROPIC_ASSIST_MODEL (비우면 기본값 claude-sonnet-5-5)
#  - 어드민 'AI 데이터 분석': ANTHROPIC_MODEL (비우면 기본값 claude-haiku-4-5)
ANTHROPIC_API_KEY=
ANTHROPIC_ANSWER_MODEL=claude-haiku-5-5
# ANTHROPIC_ASSIST_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-haiku-4-5

# [선택 · 음성] OpenAI — 통화 녹음 전사와 응대 자산 'AI 답변 들어보기'
#  ⚠ 반드시 OpenAI 키(sk-…)를 넣는다. Anthropic 키(sk-ant-…)를 넣으면 둘 다 401 로 실패한다.
#  (키가 없어도 '녹취 붙여넣기' 분석은 Claude 로 동작한다)
#  OPENAI_STT_MODEL: 비우면 기본값 gpt-4o-mini-transcribe — 분당 약 $0.003 로 whisper-1 의 절반 가격
OPENAI_API_KEY=
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_SUGGEST_MODEL=gpt-4o-mini

# [선택 · 음성] 드롭박스 — 통화 녹음 원본을 회사 드롭박스 녹음 폴더에 통화일별로 보관(lib/dropbox.ts)
#  브라우저가 드롭박스에 바로 올려 Vercel 요청 크기 제한(4.5MB)을 피하고, 앱에는 분석 자료와 원본 경로만 남긴다.
#  dropbox.com/developers/apps 에서 앱(Scoped access · Full Dropbox · files.metadata.read / files.content.read / files.content.write)을 만들고
#  App key·secret 을 넣은 뒤, 처음 한 번 '허용'으로 받은 오래 쓰는 키를 DROPBOX_REFRESH_TOKEN 에. 비우면 베타 로컬 폴더(.voice-uploads)에 둔다.
#  녹취 기록을 지워도 드롭박스 원본은 지우지 않는다(녹음 3년 보관).
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REFRESH_TOKEN=
# DROPBOX_VOICE_FOLDER=/2026_요기코퍼레이션_온라인·마케팅·디자인/04_개발/cs/csVoice

# [선택] cafe24 — 셀프가이드 배송조회 · 상담 콘솔 주문 조회
#  토큰은 adminChat·yChat 이 갱신해 공유 DB(tokens 컬렉션)에 저장하고, 이 앱은 '읽기만' 한다.
#  CAFE24_TOKEN_MONGODB_URI 는 adminChat 의 MONGODB_URI 와 같은 클러스터 — 읽기 전용 계정 권장.
#  (더 이상 쓰지 않음: CAFE24_CLIENT_ID · CAFE24_CLIENT_SECRET · ACCESS_TOKEN · REFRESH_TOKEN)
CAFE24_MALLID=yogibo
CAFE24_TOKEN_MONGODB_URI=
CAFE24_TOKEN_DB_NAME=yogibo
# CAFE24_API_VERSION=2025-12-01
# 자사몰 외에 셀프가이드를 iframe 으로 띄울 도메인(쉼표 구분)
# CAFE24_IFRAME_PARENTS=

# [선택] onlineData(MCP) — 미답변 배지 · AI 도우미의 스마트스토어·매장 택배 주문 찾기 · 게시판 관리의 스마트스토어 고객문의
#  onlineData MCP 서버(cloudtype)의 MCP_TOKENS 에 이 앱용 항목을 'cs-self-guide:<토큰>:answer' 로 넣고 같은 <토큰>을 여기에.
#  answer 권한이어야 스마트스토어 문의에 답변을 등록할 수 있다(read 면 목록만). 비우면 홈페이지(cafe24)만 쓴다.
ONLINEDATA_MCP_TOKEN=
# ONLINEDATA_BASE_URL=https://port-0-yogibo-onmcp-lzgmwhc4d9883c97.sel4.cloudtype.app

# [선택] 네이버 톡톡 — 톡톡으로 온 문의를 실시간 상담에서 받고, 여기서 쓴 답을 고객 톡톡으로 보낸다(lib/naverTalk.ts)
#  톡톡 파트너센터 → 계정관리 → 연동 관리(개발자도구) → [챗봇API 설정] 신청 후
#   · 이벤트 받을 URL: https://<운영 서버 주소>/api/naver-talk/<NAVER_TALK_WEBHOOK_SECRET> · 이벤트: send, open, leave, echo
#   · [보내기 API] 에서 만든 Authorization 키 → NAVER_TALK_AUTH_KEY
#  NAVER_TALK_WEBHOOK_SECRET: 16자 이상(권장 32자) 임의 문자열 — 주소에 들어가 비밀번호 역할. 둘 중 하나라도 비면 톡톡은 꺼진다.
#  NAVER_TALK_CHECK_IP=1: 네이버 IP 대역에서 온 요청만 받는다(운영 서버가 x-forwarded-for 맨 앞에 실제 접속 IP를 넣을 때만 켠다)
#  ⚠ 스마트스토어 '톡톡 쇼핑챗봇·AI FAQ'가 켜져 있으면 챗봇 API 가 동작하지 않는다 — 스마트스토어센터 → 문의/리뷰관리 → 톡톡상담관리에서 끈다
#  ⚠ 연결 전 대화는 가져오지 못한다(톡톡 파트너센터에만 남음)
#  톡톡 계정이 둘이면(예: 스마트스토어 Yogibo W5X4LF + 네이버페이·yogibo.kr 요기보 Yogibo WC4U67) 둘째 계정은 같은 이름 끝에 _2 —
#  계정마다 보내기 키·받는 주소(비밀값)가 따로이고, 답장은 그 상담이 들어온 계정으로 나간다. NAVER_TALK_NAME 은 화면에 보일 계정 이름.
# NAVER_TALK_AUTH_KEY=
# NAVER_TALK_WEBHOOK_SECRET=
# NAVER_TALK_NAME=Yogibo(스마트스토어)
# NAVER_TALK_AUTH_KEY_2=
# NAVER_TALK_WEBHOOK_SECRET_2=
# NAVER_TALK_NAME_2=요기보 Yogibo(네이버페이)
# NAVER_TALK_CHECK_IP=1

# [선택] 운영
#  BLOCKED_IPS: 통계에서 뺄 IP(회사 IP 등), 쉼표 구분 — 답변은 정상 제공하고 기록만 뺀다
#  AI_QUERY_RATE_LIMIT: 고객 AI 질문 IP당 1분 횟수 제한(기본 15)
# BLOCKED_IPS=
# AI_QUERY_RATE_LIMIT=15
